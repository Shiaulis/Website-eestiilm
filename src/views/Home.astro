---
// The placeholder home page, shared by / and /et/. The landing page ticket (EES-109) replaces it
// and removes `noindex`, so search engines don't index the placeholder.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '../i18n';
import { SITE_NAME } from '../site';

const t = useTranslations(getLocale(Astro.currentLocale));
---

<BaseLayout noindex>
	<h1>{SITE_NAME}</h1>
	<p>{t('site_description')}</p>
	<p>{t('placeholder_home')}</p>
</BaseLayout>
