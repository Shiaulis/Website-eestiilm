---
// The landing page, shared by / and /et/. Layout from the design book's Home mockup ("Quiet
// paper"): centred hero with the app icon, eyebrow, H1 pitch, paragraph and quiet TestFlight link,
// followed by a full-bleed dusk horizon line and three hairline-divided feature columns.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, splitAtPlaceholder, useTranslations } from '../i18n';
import { DATA_SOURCE_NAME, DATA_SOURCE_URL, TESTFLIGHT_URL } from '../site';

const t = useTranslations(getLocale(Astro.currentLocale));
const forecastBody = t('home_feature_forecast_body');
const forecastParts = splitAtPlaceholder(forecastBody, 'link');
---

<BaseLayout description={t('home_description')} showHeaderHorizon={false} contained={false}>
	<div class="container">
		<section class="hero">
			<picture class="hero-icon">
				<source srcset="/images/hero-icon-dark.png" media="(prefers-color-scheme: dark)" />
				<img src="/images/hero-icon.png" alt="" width="156" height="156" fetchpriority="high" />
			</picture>
			<p class="eyebrow">{t('home_eyebrow')}</p>
			<h1>{t('home_title')}</h1>
			<p class="pitch">{t('home_pitch')}</p>
			<p class="cta">
				<a href={TESTFLIGHT_URL}>{t('home_cta_testflight')}</a>
			</p>
		</section>
	</div>

	<div class="horizon" aria-hidden="true"></div>

	<div class="container">
		<section class="features" aria-label={t('home_features_label')}>
			<div class="feature">
				<div class="temps" aria-hidden="true">
					<span class="cold">−3°</span>
					<span class="warm">4°</span>
				</div>
				<h2 class="feature-title">{t('home_feature_forecast_title')}</h2>
				<p class="feature-body">
					{
						forecastParts ? (
							<>
								{forecastParts[0]}
								<a href={DATA_SOURCE_URL}>{DATA_SOURCE_NAME}</a>
								{forecastParts[1]}
							</>
						) : (
							forecastBody
						)
					}
				</p>
			</div>

			<div class="feature">
				<div class="icon" aria-hidden="true">
					<svg
						width="22"
						height="22"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						focusable="false"
					>
						<rect x="3" y="3" width="8" height="8" rx="2"></rect>
						<rect x="13" y="3" width="8" height="8" rx="2"></rect>
						<rect x="3" y="13" width="18" height="8" rx="2"></rect>
					</svg>
				</div>
				<h2 class="feature-title">{t('home_feature_widgets_title')}</h2>
				<p class="feature-body">{t('home_feature_widgets_body')}</p>
			</div>

			<div class="feature">
				<div class="icon" aria-hidden="true">
					<svg
						width="22"
						height="22"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						focusable="false"
					>
						<path d="M12 3l7 3v5c0 4.5-3 8.3-7 9.5C8 19.3 5 15.5 5 11V6l7-3Z"></path>
					</svg>
				</div>
				<h2 class="feature-title">{t('home_feature_privacy_title')}</h2>
				<p class="feature-body">{t('home_feature_privacy_body')}</p>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	/* Design book: 88px above the icon (<main> already adds 72px on desktop) and 80px below the CTA. */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 16px 0 80px;
		text-align: center;
	}

	.hero-icon img {
		display: block;
		width: 156px;
		height: 156px;
	}

	.eyebrow {
		margin: 28px 0 0;
		color: var(--color-secondary-text);
		font-size: 0.8125rem; /* 13px */
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 51.25rem; /* 820px */
		margin: 12px 0 20px;
		font-size: 4rem; /* 64px */
		line-height: 1.03;
	}

	.pitch {
		max-width: 37.5rem; /* 600px */
		margin: 0 0 34px;
		color: var(--color-secondary-text);
		font-size: 1.1875rem; /* 19px */
		line-height: 1.55;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 22px;
		margin: 0;
	}

	/* Three hairline-divided feature columns; footer adds 56px below (72px total on desktop). */
	.features {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		padding: 72px 0 16px;
	}

	.feature {
		padding: 0 36px;
		border-left: 1px solid var(--color-separator);
	}

	.feature:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.feature:last-child {
		padding-right: 0;
	}

	.temps {
		display: flex;
		align-items: baseline;
		gap: 14px;
		font-family: var(--font-heading);
		font-size: 2.75rem; /* 44px */
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.cold {
		color: var(--color-cold);
	}

	.warm {
		color: var(--color-warm);
	}

	.icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border-radius: 14px;
		background: var(--color-card);
		color: var(--color-accent);
	}

	/* Real <h2> headings for a clean outline, sized to the design book's 21px feature titles. */
	.feature-title {
		margin: 18px 0 6px;
		font-size: 1.3125rem; /* 21px */
		line-height: 1.25;
		letter-spacing: 0;
	}

	.feature-body {
		margin: 0;
		color: var(--color-secondary-text);
	}

	/* Stack feature columns below 64em (1024px) so columns never squeeze on tablets. */
	@media (max-width: 64em) {
		.features {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 34px;
			padding: 56px 0 16px;
		}

		.feature {
			padding: 0;
			border-left: 0;
		}
	}

	@media (max-width: 40em) {
		.hero {
			padding: 8px 0 48px;
		}

		.hero-icon img {
			width: 116px;
			height: 116px;
		}

		.hero h1 {
			font-size: 2.375rem; /* 38px */
		}

		.pitch {
			font-size: 1.0625rem; /* 17px */
		}

		.features {
			padding: 44px 0 0;
		}
	}
</style>
