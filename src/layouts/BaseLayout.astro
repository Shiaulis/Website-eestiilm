---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, getLocale, locales, pathWithoutLocale, useTranslations } from '../i18n';
import { SITE_NAME } from '../site';
import '../styles/global.css';

interface Props {
	/** Page title without the site name; omit on the home page. */
	title?: string;
	description?: string;
	/** Keeps the page out of search results (placeholders, 404). */
	noindex?: boolean;
	/**
	 * The 404 page. Apache serves it for any missing URL, so it has no address of its own:
	 * no canonical or hreflang links, no og:url, `noindex`, and the language switch goes to
	 * each language's home page.
	 */
	notFound?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { title, description = t('site_description'), notFound = false } = Astro.props;
const noindex = notFound || (Astro.props.noindex ?? false);

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = pathWithoutLocale(Astro.url.pathname);
const canonicalURL = getAbsoluteLocaleUrl(locale, path);

// Link previews (Messages, Slack, social sites): one image for both languages, light only.
const shareImageURL = new URL('/og-image.png', Astro.site);
const ogLocales: Record<typeof locale, string> = { en: 'en_US', et: 'et_EE' };
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- The page follows the system's light or dark mode; the colours are in src/styles/global.css. -->
		<meta name="color-scheme" content="light dark" />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{
			!notFound && (
				<>
					<link rel="canonical" href={canonicalURL} />
					<!-- The same page in every language, so search engines show the right one. -->
					{locales.map((l) => (
						<link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />
					))}
					<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
				</>
			)
		}

		<!-- Browser tab icon (SVG, with a 32px .ico for older browsers) and the iOS home screen icon. -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- Start loading the heading font right away, so headings don't change font after they appear. -->
		<link rel="preload" href="/fonts/nunito-800.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Open Graph and Twitter card: the title, text and image of a shared link's preview. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{!notFound && <meta property="og:url" content={canonicalURL} />}
		<meta property="og:locale" content={ogLocales[locale]} />
		{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
		<meta property="og:image" content={shareImageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('site_share_image_alt')} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Header languageSwitchPath={notFound ? '/' : undefined} />
		<div class="horizon"></div>
		<main class="container">
			<slot />
		</main>
		<Footer />
	</body>
</html>

