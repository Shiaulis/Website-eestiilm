---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, getLocale, locales, pathWithoutLocale, useTranslations } from '../i18n';
import { SITE_NAME } from '../site';

interface Props {
	/** Page title without the site name; omit on the home page. */
	title?: string;
	description?: string;
	/** Keeps the page out of search results (placeholders, 404). */
	noindex?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { title, description = t('site.description'), noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = pathWithoutLocale(Astro.url.pathname);
const canonicalURL = getAbsoluteLocaleUrl(locale, path);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Browser default colours follow the system's light or dark mode. EES-113 adds the palette. -->
		<meta name="color-scheme" content="light dark" />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalURL} />

		<!-- The same page in every language, so search engines show the right one. -->
		{locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	/* Layout only: a readable line length and some breathing room on phones. EES-113 adds the design. */
	body {
		max-width: 40rem;
		margin: 0 auto;
		padding: 1rem;
		line-height: 1.5;
	}

	header ul,
	footer ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding: 0;
		list-style: none;
	}
</style>
